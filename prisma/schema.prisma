// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum RolUsuario {
  ADMINISTRADOR
  GERENCIA
  COORDINADOR
  COLABORADOR
}

enum EstadoCliente {
  PROSPECTO
  EN_ACERCAMIENTO
  CLIENTE_ACTIVO
  EN_PAUSA
  STANDBY
  INACTIVO
  CERRADO
}

enum TipoCliente {
  GOBIERNO_LOCAL
  GOBIERNO_NACIONAL
  COOPERANTE_MULTILATERAL
  EMPRESA_PRIVADA
  FUNDACION
  ALIADO_ACADEMICO
  ALIADO_ESTRATEGICO
  OTRO
}

enum PrioridadCliente {
  ALTA
  MEDIA
  BAJA
}

enum RolContacto {
  DECISOR
  TECNICO
  INFLUENCIADOR
  OTRO
}

enum EstadoOportunidad {
  DISENANDO_PROPUESTA
  PRESENTADA
  EN_REVISION
  EN_NEGOCIACION
  GANADA
  PERDIDA
  STANDBY
}

enum FaseOportunidad {
  PROSPECCION
  EJECUCION
}

// v7 alignment C3a (Interacciones): the kind of a bitácora entry. `OTRO` is
// the default so every pre-existing row (and any writer that predates this
// unit) keeps working unchanged.
enum TipoInteraccion {
  REUNION
  CORREO
  LLAMADA
  VISITA
  OTRO
}

enum EstadoTarea {
  POR_HACER
  EN_CURSO
  EN_REVISION
  COMPLETADA
  BLOQUEADA
  EN_ESPERA
  CANCELADA // estado oculto en tablero, visible en reportes
}

enum OrigenTarea {
  CRM
  KANBAN
  AMBOS
}

enum PrioridadTarea {
  ALTA
  MEDIA
  BAJA
}

enum TipoNotificacion {
  COMPROMISO_VENCIDO
  TAREA_VENCIDA
  POR_VENCER
  SOBREGASTO_RUBRO
  GASTO_RECHAZADO
}

// v2 projects module (RF-04) — lifecycle of a project. New enum on this branch:
// the v1 projects module never shipped, so the migration creates it together
// with the tables (there is no separate ADD VALUE migration).
enum EstadoProyecto {
  PLANIFICACION
  BORRADOR
  EN_EJECUCION
  SUSPENDIDO
  CERRADO
  CANCELADO
}

// v2 projects module (ADR-09) — how a project came to exist: converted from a
// GANADA opportunity (OPORTUNIDAD, with `oportunidad_id` set) or created
// directly (INDEPENDIENTE, with `oportunidad_id` null).
enum OrigenProyecto {
  OPORTUNIDAD
  INDEPENDIENTE
}

// ─────────────────────────────────────────
// MODELOS
// ─────────────────────────────────────────

model Usuario {
  id                     String     @id @default(uuid())
  email                  String     @unique
  nombre                 String
  rol                    RolUsuario @default(COLABORADOR)
  activo                 Boolean    @default(true)
  // Eje comercial ortogonal a `rol` (oportunidades-comerciales D3). Sembrado
  // por la migración para los COLABORADORES responsables de clientes con al
  // menos una oportunidad viva, así el deploy no deja a nadie sin acceso.
  gestiona_oportunidades Boolean    @default(false)
  // Eje de lectura gerencial ortogonal a `rol` (v2 S9, REQ-ACC-02): habilita el tablero
  // de portafolio y solo lectura; nunca concede escritura ni soportes financieros.
  puede_ver_tablero_gerencial Boolean @default(false)
  created_at             DateTime   @default(now())
  updated_at             DateTime   @updatedAt

  clientes_asignados Cliente[]
  tareas_asignadas   Tarea[]
  bitacora_entradas  BitacoraEntrada[]
  contactos_propietario Contacto[] @relation("ContactoOwner")
  documentos_subidos Documento[]
  notificaciones     Notificacion[]
  accesos            Acceso[] // PRD §3.3
  auditorias         Auditoria[]
  proyectos_responsable Proyecto[] @relation("ProyectoResponsable")
  proyectos_miembro ProyectoMiembro[] @relation("MiembroProyecto")
  actividades_responsable Actividad[] @relation("ActividadResponsable")

  @@map("usuarios")
}

model Cliente {
  id                        String            @id @default(uuid())
  nombre                    String
  empresa                   String?
  tipo_cliente              TipoCliente
  tamano_org                String?
  ubicacion                 String?
  canal_contacto_inicial    String?
  fecha_primer_contacto     DateTime?
  prioridad                 PrioridadCliente?
  prioridades_identificadas String?
  riesgos_barreras          String?
  resumen_relacion          String?
  estado                    EstadoCliente     @default(PROSPECTO)
  // Mismo catálogo que las tareas (setting `task_tags`).
  etiquetas                 String[]          @default([])
  responsable_id            String
  created_at                DateTime          @default(now())
  updated_at                DateTime          @updatedAt
  deleted_at                DateTime?

  responsable   Usuario            @relation(fields: [responsable_id], references: [id])
  contactos     Contacto[]
  oportunidades Oportunidad[]
  tareas        Tarea[]
  bitacora      BitacoraEntrada[]
  documentos    DocumentoCliente[]
  proyectos     Proyecto[]
  carpeta       Carpeta?

  @@map("clientes")
}

model Contacto {
  id           String       @id @default(uuid())
  cliente_id   String
  nombre       String
  cargo        String?
  correo       String?
  telefono     String?
  rol_decision RolContacto?
  notas        String?
  // v7 alignment C4a (Relaciones): the power × interest matrix. Both axes are
  // 1..5 and the relationship strength is 1..3. Nullable so every pre-existing
  // row keeps working — a contact without a quadrant is valid.
  poder           Int?
  interes         Int?
  fuerza_relacion Int?
  // v7 C4a: optional internal owner ("Relación: owner" in the v7 contact list).
  // Nullable and not required; when set the global feed exposes the owner name.
  owner_id        String?
  created_at   DateTime     @default(now())
  deleted_at   DateTime?

  cliente Cliente  @relation(fields: [cliente_id], references: [id])
  owner   Usuario? @relation("ContactoOwner", fields: [owner_id], references: [id])

  @@map("contactos")
}

model Oportunidad {
  id                     String            @id @default(uuid())
  cliente_id             String
  nombre                 String
  problema_detectado     String?
  solucion_propuesta     String?
  servicios_interes      String?
  valor_estimado_cop     Decimal?          @db.Decimal(15, 2)
  estado                 EstadoOportunidad @default(DISENANDO_PROPUESTA)
  fecha_ultima_gestion   DateTime?
  // Ciclo comercial trazable (oportunidades-comerciales D2). `fase` distingue
  // prospección de ejecución tras la conversión explícita y auditada de una
  // oportunidad GANADA; `fecha_adjudicacion` se fija una sola vez por esa
  // acción. `fecha_envio_propuesta` (RF-C03) es fija: se setea la primera vez
  // que se registra el envío y nunca se sobreescribe en PATCH posteriores —
  // a diferencia de `fecha_ultima_gestion`, que sigue mutando en cada PATCH.
  fase                   FaseOportunidad   @default(PROSPECCION)
  fecha_adjudicacion     DateTime?
  fecha_envio_propuesta  DateTime?
  /// @deprecated oportunidades-comerciales D8 — superseded by `fase` +
  /// `Tarea.oportunidad_id`. Read-only in the UI; kept additive, not dropped.
  proyectos_relacionados String?
  created_at             DateTime          @default(now())
  updated_at             DateTime          @updatedAt
  deleted_at             DateTime?

  cliente  Cliente           @relation(fields: [cliente_id], references: [id])
  tareas   Tarea[]
  bitacora BitacoraEntrada[]
  proyecto Proyecto?

  // Objetivo de la FK compuesta de Tarea/BitacoraEntrada (D1): garantiza a
  // nivel de base de datos que una tarea u entrada de bitácora vinculada a
  // esta oportunidad solo pueda apuntar al mismo cliente_id.
  @@unique([id, cliente_id])
  @@map("oportunidades")
}

// Tabla unificada CRM + Kanban
model Tarea {
  id             String          @id @default(uuid())
  titulo         String
  descripcion    String?
  responsable_id String
  cliente_id     String?
  // Vínculo opcional a una oportunidad comercial (oportunidades-comerciales
  // D1/RF-C02). Sin backfill: toda tarea preexistente queda con este campo
  // en NULL — el re-vinculado es manual desde la vista de la oportunidad.
  oportunidad_id String?
  estado         EstadoTarea     @default(POR_HACER)
  origen         OrigenTarea     @default(KANBAN)
  prioridad      PrioridadTarea?
  fecha_entrega  DateTime?
  etiquetas      String[]        @default([])
  motivo_bloqueo String? // solo cuando estado = BLOQUEADA
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  deleted_at     DateTime?
  // Plan Fase 3 (3B): la marca REAL de cierre, agregada porque updated_at
  // (el proxy histórico) se movía al renombrar/comentar una tarea ya
  // completada — el reporte pasaba retroactivamente "a tiempo" a "tarde".
  // Nullable y con backfill (SET = updated_at WHERE estado='COMPLETADA');
  // null = nunca completada (o reabierta tras completarse). Se escribe solo
  // desde el helper central completedAtFor (status + PATCH).
  completed_at   DateTime?

  responsable    Usuario           @relation(fields: [responsable_id], references: [id])
  cliente        Cliente?          @relation(fields: [cliente_id], references: [id])
  // Relación compuesta deliberada (D1): comparte el escalar `cliente_id` con
  // la relación `cliente` de arriba. Esa superposición ES el invariante —
  // hace imposible, a nivel de base de datos, que una tarea apunte a una
  // oportunidad de un cliente distinto al suyo. `onDelete/onUpdate: NoAction`
  // es obligatorio: dos relaciones que comparten un escalar generan rutas de
  // cascada en conflicto, que Prisma rechaza. El borrado lógico
  // (`deleted_at`) es el modelo de borrado del proyecto de todos modos, así
  // que `NoAction` no cuesta nada. El `CHECK` que cierra el hueco de
  // MATCH SIMPLE (cliente_id NULL) vive en la migración — Prisma no modela
  // constraints CHECK.
  oportunidad    Oportunidad?      @relation(fields: [oportunidad_id, cliente_id], references: [id, cliente_id], onDelete: NoAction, onUpdate: NoAction)
  comentarios    ComentarioTarea[]
  subtareas      Subtarea[]
  adjuntos       AdjuntoTarea[]
  notificaciones Notificacion[]

  @@index([oportunidad_id])
  @@map("tareas")
}

// Inmutable por diseño — sin updated_at
model BitacoraEntrada {
  id             String   @id @default(uuid())
  cliente_id     String
  autor_id       String
  texto          String
  // Comunicación específica de una oportunidad (oportunidades-comerciales).
  // Nullable: las entradas atadas solo al cliente no se ven afectadas.
  oportunidad_id String?
  // v7 alignment C3a (Interacciones): the kind of interaction. Defaults to
  // OTRO so legacy rows and old writers stay valid — this column is additive.
  tipo           TipoInteraccion @default(OTRO)
  // v7 C3a: optional next step agreed in the interaction (free text).
  proximo_paso   String?
  created_at     DateTime @default(now())

  cliente     Cliente      @relation(fields: [cliente_id], references: [id])
  autor       Usuario      @relation(fields: [autor_id], references: [id])
  // Misma relación compuesta que Tarea (D1) — cliente_id compartido es el
  // invariante. `BitacoraEntrada.cliente_id` ya es NOT NULL, así que el hueco
  // de MATCH SIMPLE no existe aquí; el CHECK de la migración es solo para
  // `tareas`.
  oportunidad Oportunidad? @relation(fields: [oportunidad_id, cliente_id], references: [id, cliente_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cliente_id])
  @@map("bitacora_entradas")
}

// La carpeta es el eje de ORGANIZACIÓN, nunca el de permisos: `categoria` es lo
// que leen canReadCategory y los gates de subida/zip. Mover un documento entre
// carpetas jamás puede cambiar quién lo lee — esa escalada de privilegios
// disparada por un gesto de organización es exactamente lo que este modelo evita.
model Carpeta {
  id            String    @id @default(uuid())
  nombre        String
  parent_id     String? // null = raíz; no hay fila "root"
  // Carpeta de cliente: a lo sumo una por cliente. Subir o soltar un archivo aquí
  // lo vincula a ese cliente; los permisos siguen saliendo de `categoria`.
  cliente_id    String?   @unique
  creado_por_id String
  created_at    DateTime  @default(now())
  deleted_at    DateTime?

  parent     Carpeta?    @relation("CarpetaArbol", fields: [parent_id], references: [id])
  hijas      Carpeta[]   @relation("CarpetaArbol")
  cliente    Cliente?    @relation(fields: [cliente_id], references: [id], onDelete: SetNull)
  documentos Documento[]

  @@index([parent_id])
  @@map("carpetas")
}

model Documento {
  id         String    @id @default(uuid())
  titulo     String
  categoria  String // String libre — configurable desde admin sin tocar código
  etiquetas  String[]  @default([])
  autor_id   String
  created_at DateTime  @default(now())
  deleted_at DateTime?
  carpeta_id String?

  autor          Usuario            @relation(fields: [autor_id], references: [id])
  carpeta        Carpeta?           @relation(fields: [carpeta_id], references: [id])
  versiones      DocumentoVersion[]
  clientes       DocumentoCliente[]
  adjuntos_tarea AdjuntoTarea[] // QA audit finding #12: espejo del adjunto de origen, si lo hay

  // El listado por defecto filtra deleted_at y ordena por created_at desc.
  @@index([deleted_at, created_at])
  @@index([carpeta_id])
  @@map("documentos")
}

model DocumentoVersion {
  id              String   @id @default(uuid())
  documento_id    String
  numero_version  Int
  storage_path    String // path en Supabase Storage
  tamano_bytes    Int?
  tipo_archivo    String?
  subido_por_id   String
  created_at      DateTime @default(now())
  contenido_texto String? // texto extraído (null = sin texto / sin procesar)
  texto_estado    String? // "ok" | "sin_texto" | "error" | null (= nunca procesado)

  documento Documento @relation(fields: [documento_id], references: [id])

  @@unique([documento_id, numero_version])
  @@map("documento_versiones")
}

model DocumentoCliente {
  documento_id String
  cliente_id   String

  documento Documento @relation(fields: [documento_id], references: [id])
  cliente   Cliente   @relation(fields: [cliente_id], references: [id])

  @@id([documento_id, cliente_id])
  // La PK compuesta (documento_id, cliente_id) no sirve para el filtro ?cliente=
  @@index([cliente_id])
  @@map("documentos_clientes")
}

model ComentarioTarea {
  id         String   @id @default(uuid())
  tarea_id   String
  autor_id   String
  texto      String
  created_at DateTime @default(now())

  tarea Tarea @relation(fields: [tarea_id], references: [id])

  @@map("comentarios_tareas")
}

model Subtarea {
  id         String  @id @default(uuid())
  tarea_id   String
  titulo     String
  completada Boolean @default(false)

  tarea Tarea @relation(fields: [tarea_id], references: [id])

  @@map("subtareas")
}

model AdjuntoTarea {
  id           String   @id @default(uuid())
  tarea_id     String
  storage_path String
  nombre       String
  tamano_bytes Int? // tamaño del archivo subido (supabase no lo expone en el listado)
  created_at   DateTime @default(now())
  // QA audit finding #12: espejo en el Repositorio de Documentos (mismo
  // storage_path, sin volver a subir el archivo). Nullable: solo lo tienen
  // los adjuntos subidos después de este cambio (sin backfill de los
  // existentes) o si el espejo falla — el adjunto en sí nunca depende de
  // esto. Sin onDelete: borrar la tarea nunca debe arrastrar el documento,
  // que sigue viviendo como registro de negocio propio en el Repositorio.
  documento_id String?

  tarea     Tarea      @relation(fields: [tarea_id], references: [id])
  documento Documento? @relation(fields: [documento_id], references: [id])

  @@map("adjuntos_tareas")
}

model Notificacion {
  id         String           @id @default(uuid())
  usuario_id String
  tipo       TipoNotificacion
  tarea_id   String?
  // v2 (S6): project notifications (overspend). Task rows keep both NULL; NULLs never
  // collide in the unique key, so there is one project row per (usuario, tipo, gasto).
  proyecto_id String?
  gasto_id    String?
  leida      Boolean          @default(false)
  created_at DateTime         @default(now())

  usuario  Usuario   @relation(fields: [usuario_id], references: [id])
  tarea    Tarea?    @relation(fields: [tarea_id], references: [id])
  proyecto Proyecto? @relation(fields: [proyecto_id], references: [id], onDelete: SetNull)
  gasto    Gasto?    @relation(fields: [gasto_id], references: [id], onDelete: SetNull)

  @@unique([usuario_id, tipo, gasto_id])
  @@index([usuario_id, leida])
  @@map("notificaciones")
}

// PRD §3.3 — bitácora de accesos (quién entró, cuándo)
model Acceso {
  id         String   @id @default(uuid())
  usuario_id String
  created_at DateTime @default(now())
  ip         String?
  user_agent String?

  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@map("accesos")
}

// QA audit finding #9: `Acceso` solo cubre inicios de sesión — no había
// ningún registro de creación/edición/eliminación de los registros de
// negocio (Cliente, Tarea, Documento). `cambios` guarda un snapshot liviano
// de los campos enviados en la operación (no un diff antes/después completo:
// eso hubiera requerido leer el estado previo en cada PATCH solo para
// auditoría). `entidad_id` no lleva FK a propósito — sobrevive al soft
// delete y a que el recurso referenciado ya no exista.
model Auditoria {
  id         String   @id @default(uuid())
  entidad    String // "cliente" | "tarea" | "documento"
  entidad_id String
  accion     String // "crear" | "editar" | "eliminar"
  usuario_id String
  cambios    Json?
  created_at DateTime @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@index([entidad, entidad_id])
  // Code review finding: GET /api/v1/auditoria siempre ordena por
  // created_at desc y opcionalmente filtra por entidad — ninguno de los
  // índices anteriores cubría ese patrón. (created_at, id) también respalda
  // el cursor compuesto de la paginación (ver el mismo hallazgo sobre el
  // cursor no único).
  @@index([created_at, id])
  @@index([entidad, created_at, id])
  @@map("auditoria")
}

// PRD §4.4.1 + §8.4 — log del cron de notificaciones (retención 30 días)
model CronLog {
  id         String   @id @default(uuid())
  job_name   String
  estado     String
  detalle    String?
  created_at DateTime @default(now())

  @@map("cron_logs")
}

// PRD §3.1 — public access requests: who asked to join and how it was approved
// (email form or Google OAuth). `revisado_por` / `auth_id` are log-only
// columns without FK (same pattern as Setting.updated_by).
model SolicitudAcceso {
  id           String    @id @default(uuid())
  nombre       String
  email        String
  cargo        String?
  origen       String    @default("form") // "form" | "google" — how the request arrived
  auth_id      String? // when origen=google: id of the auth user already created by Supabase
  estado       String    @default("PENDIENTE") // PENDIENTE | APROBADA | RECHAZADA
  revisado_por String?
  revisado_at  DateTime?
  created_at   DateTime  @default(now())

  @@map("solicitudes_acceso")
}

// PRD §3.3 — setting key/value para los catálogos configurables desde el admin
// (task_tags, doc_categories y futuros). `value` guarda el JSON del catálogo;
// `updated_by` es el id del usuario que lo editó (sin FK, log-only).
model Setting {
  id         String   @id @default(uuid())
  key        String   @unique
  value      Json
  updated_by String?
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  @@map("settings")
}

// v2 projects module (RF-04, RNF-05, est §7.4) — audit con antes/después por
// campo. Es *append-only a nivel de base de datos*: la migración
// `v2_auditoria_cambios` instala un trigger que rechaza UPDATE, DELETE y
// TRUNCATE, así que la aplicación no puede alterar el registro ni por error.
//
// `usuario_id` no lleva FK a propósito (a diferencia del modelo v1
// `Auditoria`, que sí la tiene): el libro debe sobrevivir a cambios de usuario.
// `proyecto_id` tampoco la lleva, para que el histórico de un proyecto
// eliminado siga siendo legible.
enum AccionAuditoria {
  CREAR
  EDITAR
  IMPORTAR
  APROBAR
  VALIDAR
  RECHAZAR
  SUSPENDER
  CAMBIAR_PARAMETRO
  ANULAR
  SOLICITAR
  EXPORTAR
  CONVERTIR
}

model AuditoriaCambio {
  id             String          @id @default(uuid())
  created_at     DateTime        @default(now())
  usuario_id     String
  accion         AccionAuditoria
  entidad        String // "proyecto" | "objetivo" | "actividad" | ...
  entidad_id     String
  proyecto_id    String?
  campo          String?
  valor_anterior Json?
  valor_nuevo    Json?
  lote_id        String? // agrupa una operación completa (import, aprobación)

  @@index([proyecto_id, created_at])
  @@index([entidad, entidad_id])
  @@map("auditoria_cambios")
}

// v2 projects module (REQ-CAT-01, REQ-CAT-02) — catálogo único de rubros
// R01..R15. `codigo` es `String?` a propósito: la migración adoptiva reutiliza
// la tabla v1 `rubros` que producción ya tiene, cuyas filas "Material POP" y
// "Operación logística" quedan suspendidas y SIN código (no se ofrecen a
// ningún proyecto). El índice único admite varios NULL, y el trigger
// `rubros_codigo_inmutable` (ver la migración) rechaza cambiar un código
// existente. `orden` fija la secuencia R01..R15. Sin FKs especulativas: hoy
// nada referencia un rubro (las líneas presupuestales llegan en S5.x).
model Rubro {
  id         String   @id @default(uuid())
  codigo     String?  @unique
  nombre     String
  activo     Boolean  @default(true)
  orden      Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  lineas LineaPresupuestal[]

  @@map("rubros")
}

// v2 projects module (REQ-CAT-03) — catálogo de líneas estratégicas LE01..LE08.
// Greenfield on this branch: no `lineas_estrategicas` table exists in any
// environment, so `codigo` is NOT NULL (unlike `rubros`, whose adopted legacy
// rows keep a NULL code). `codigo` is immutable — the trigger
// `lineas_estrategicas_codigo_inmutable` (see the migration) rejects changing
// an existing code — and `orden` fixes the LE01..LE08 sequence.
// `fecha_suspension` records WHEN a line was suspended (`activo=false`):
// suspension is the only way out, because rows are never deleted. No FKs yet:
// `ProyectoLinea` arrives with S2.1.
model LineaEstrategicaCatalogo {
  id               String    @id @default(uuid())
  codigo           String    @unique
  nombre           String
  activo           Boolean   @default(true)
  fecha_suspension DateTime?
  orden            Int       @default(0)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  lineas ProyectoLinea[]
  @@map("lineas_estrategicas")
}

// v2 projects module (REQ-CAT-04) — catálogo administrable de municipios.
// Greenfield on this branch: no `municipios` table exists in any environment,
// so the migration creates it and seeds NOTHING. N-21 asked for the catalog to
// be filled from the normalised legacy `territorio` values, but no `territorio`
// field or enum exists in this repository: there is nothing to normalise and a
// national list would be invented data. `codigo_dane` is optional and unique
// only WHEN PRESENT: the unique index admits several NULLs (Postgres treats
// them as distinct). `(nombre, departamento)` is unique together, so the same
// municipality name may repeat across departments but never inside one.
// `fecha_suspension` records WHEN a municipio was suspended (`activo=false`):
// suspension is the only way out, because rows are never deleted. No FKs yet:
// `Proyecto` arrives with S2.1.
model Municipio {
  id               String    @id @default(uuid())
  nombre           String
  departamento     String
  codigo_dane      String?   @unique
  activo           Boolean   @default(true)
  fecha_suspension DateTime?
  orden            Int       @default(0)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@unique([nombre, departamento])
  proyectos ProyectoMunicipio[]
  @@map("municipios")
}

// v2 projects module (RF-04, ADR-09) — the `Proyecto` aggregate. Greenfield on
// this branch: the v1 module never shipped, so this is the first definition.
//
// `codigo` (PRY-AAAA-NNN) is generated by the later S2.2 sequence; the column
// and its unique index exist now. `oportunidad_id` is the 1:1 link to a GANADA
// opportunity and is null for an INDEPENDIENTE project; `origen` distinguishes
// the two paths. `umbrales_override` holds per-project threshold overrides as
// free-form JSON, never a CHECK-constrained shape.
//
// `oportunidad` is a COMPOSITE optional relation sharing `cliente_id` with
// `cliente`, exactly like `Tarea.oportunidad`: the shared scalar makes it
// impossible for a project to point at an opportunity of a different client.
// `NoAction` is required because two relations sharing a scalar cannot have
// conflicting cascade paths. `Cliente`, `Oportunidad` and `Usuario` carry the
// matching back-relations (`proyectos`, `proyecto`, `proyectos_responsable`).
model Proyecto {
  id                           String          @id @default(uuid())
  codigo                       String          @unique // PRY-AAAA-NNN; generated by the later S2.2
  nombre                       String
  descripcion                  String?
  cliente_id                   String
  oportunidad_id               String?         @unique // 1:1 with a GANADA opportunity; null when INDEPENDIENTE
  responsable_id               String?
  estado                       EstadoProyecto  @default(BORRADOR)
  origen                       OrigenProyecto?
  fecha_inicio                 DateTime?       @db.Date
  fecha_fin                    DateTime?       @db.Date
  valor_total                  Decimal?        @db.Decimal(15, 2)
  diferencia_valor_oportunidad Decimal?        @db.Decimal(15, 2)
  beneficiarios_meta           Int?
  umbrales_override            Json?
  programacion_pendiente       Boolean         @default(false)
  created_at                   DateTime        @default(now())
  updated_at                   DateTime        @updatedAt
  deleted_at                   DateTime?

  cliente     Cliente       @relation(fields: [cliente_id], references: [id])
  oportunidad Oportunidad?  @relation(fields: [oportunidad_id, cliente_id], references: [id, cliente_id], onDelete: NoAction, onUpdate: NoAction)
  responsable Usuario?      @relation("ProyectoResponsable", fields: [responsable_id], references: [id])
  lineas      ProyectoLinea[]
  municipios  ProyectoMunicipio[]
  miembros    ProyectoMiembro[]
  objetivos   Objetivo[]
  actividades Actividad[]
  entregables Entregable[]
  indicadores Indicador[]
  avances_entregable AvanceEntregable[]
  reportes_actividad ReporteActividad[]
  mediciones_indicador MedicionIndicador[]
  registros_beneficiarios RegistroBeneficiario[]
  soportes_proyecto  SoporteProyecto[]
  lineas_presupuestales LineaPresupuestal[]
  programacion_periodos ProgramacionPeriodo[]
  gastos                Gasto[]
  notificaciones        Notificacion[]
  versiones             VersionProyecto[]
  solicitudes           SolicitudModificacion[]

  @@unique([oportunidad_id, cliente_id])
  @@index([cliente_id])
  @@index([estado])
  @@map("proyectos")
}

// v2 projects module (DP-05) — N..N between a project and the strategic-line
// catalog, with AT MOST ONE principal per project enforced by the partial
// unique index `proyecto_lineas_principal_uq` in the migration (Prisma cannot
// express a partial index). Exactly one principal is a service-layer rule.
model ProyectoLinea {
  proyecto_id String
  linea_id    String
  principal   Boolean @default(false)

  proyecto Proyecto                 @relation(fields: [proyecto_id], references: [id])
  linea    LineaEstrategicaCatalogo @relation(fields: [linea_id], references: [id])

  @@id([proyecto_id, linea_id])
  @@map("proyecto_lineas")
}

// v2 projects module (REQ-CAT-04) — N..N between a project and the municipio
// catalog.
model ProyectoMunicipio {
  proyecto_id  String
  municipio_id String

  proyecto  Proyecto  @relation(fields: [proyecto_id], references: [id])
  municipio Municipio @relation(fields: [municipio_id], references: [id])

  @@id([proyecto_id, municipio_id])
  @@map("proyecto_municipios")
}

// v2 projects module (S2.6, ADR-09, DP-06, N-20) — project team membership. A
// membership is never hard-deleted: `removed_at` soft-revokes access while the
// row is kept for history, and a removed member can be re-added later. That is
// why `id` is a surrogate primary key and `(proyecto_id, usuario_id)` cannot
// be: the same pair legitimately repeats over time. The migration adds the
// partial unique index `proyecto_miembros_activo_uq` over
// `(proyecto_id, usuario_id) WHERE removed_at IS NULL` — Prisma cannot express
// a partial index, and it is the only DB-level guard for "at most one active
// membership per pair". `(usuario_id, removed_at)` is indexed because
// `es_miembro` probes exactly that pair. `agregado_por_id` and
// `removido_por_id` are the audit trail of who granted and revoked the
// membership: they are plain columns with NO relation and NO foreign key on
// purpose, mirroring `auditoria_cambios.usuario_id` — an audit pointer must
// outlive the actor it names. `puede_ver_tablero_gerencial` is intentionally
// absent: the managerial-board flag belongs to a later slice.
model ProyectoMiembro {
  id              String    @id @default(uuid())
  proyecto_id     String
  usuario_id      String
  agregado_por_id String
  created_at      DateTime  @default(now())
  removed_at      DateTime?
  removido_por_id String?

  proyecto Proyecto @relation(fields: [proyecto_id], references: [id])
  usuario  Usuario  @relation("MiembroProyecto", fields: [usuario_id], references: [id])

  @@index([proyecto_id])
  @@index([usuario_id, removed_at])
  @@map("proyecto_miembros")
}

// v2 projects module (S2.2, SDD §4.2) — per-year counter that issues the
// `PRY-AAAA-NNN` project codes. `anio` is the primary key, so the upsert in
// `src/lib/api/project-code.ts` locks one row per year and two concurrent
// creations can never share a sequence. Deliberately standalone: it has no
// relation because `anio` is not a project column, and the migration seeds no
// rows — the first allocation initialises the counter from `proyectos`.
model ProyectoSecuencia {
  anio   Int  @id
  ultimo Int  @default(0)

  @@map("proyecto_secuencias")
}

// v2 projects module (S3, SDD §4.8) — a specific objective of a project's
// technical structure. Soft-deleted through `deleted_at`. The migration adds
// the partial unique index `objetivos_codigo_activo_uq` over
// `(proyecto_id, lower(codigo)) WHERE deleted_at IS NULL` (Prisma cannot
// express it): the code is unique per project, ignoring case, among live rows.
// `@@unique([id, proyecto_id])` is the target of the composite same-project
// foreign keys of `Actividad` and `Indicador`, so a child can never point at an
// objective of another project.
model Objetivo {
  id          String    @id @default(uuid())
  proyecto_id String
  codigo      String
  descripcion String
  orden       Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  proyecto    Proyecto    @relation(fields: [proyecto_id], references: [id])
  actividades Actividad[]
  indicadores Indicador[]

  @@unique([id, proyecto_id])
  @@index([proyecto_id])
  @@map("objetivos")
}

// v2 projects module (S3, SDD §4.8, REQ-STR-02..04) — an activity placed in the
// project's relative weeks. Dates are NEVER stored: `fecha_inicio`/`fecha_fin`
// are derived on read from `semana_inicio`/`semana_fin` and the project start
// (`src/lib/proyectos/weeks.ts`). The migration adds what Prisma cannot
// express: CHECK `actividades_semanas_check` (1 <= inicio <= fin), CHECK
// `actividades_peso_check` (peso > 0) and the partial unique index
// `actividades_codigo_activo_uq` over `(proyecto_id, lower(codigo)) WHERE
// deleted_at IS NULL`. The composite relation `[objetivo_id, proyecto_id]`
// makes an objective of another project unreferenceable. `peso_manual` marks a
// weight the user typed; otherwise the weight is the duration in weeks.
model Actividad {
  id             String    @id @default(uuid())
  proyecto_id    String
  objetivo_id    String
  codigo         String
  nombre         String
  semana_inicio  Int
  semana_fin     Int
  // No `peso`: the activity's weight is always `semana_fin - semana_inicio + 1` (AJ-02),
  // derived in `src/lib/proyectos/weeks.ts`. A stored copy could only drift from the rule.
  responsable_id String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  proyecto    Proyecto @relation(fields: [proyecto_id], references: [id])
  objetivo    Objetivo @relation(fields: [objetivo_id, proyecto_id], references: [id, proyecto_id], onDelete: NoAction, onUpdate: NoAction)
  responsable Usuario? @relation("ActividadResponsable", fields: [responsable_id], references: [id])
  entregables Entregable[]
  beneficiarios RegistroBeneficiario[]
  reportes    ReporteActividad[]

  @@unique([id, proyecto_id])
  @@index([proyecto_id])
  @@index([objetivo_id])
  @@map("actividades")
}

// v2 projects module (S3, SDD §4.8, REQ-STR-05) — one measurable product of an
// activity. `proyecto_id` is denormalised on purpose: the code is unique per
// PROJECT (`1.4-E1`), and the composite relation `[actividad_id, proyecto_id]`
// makes an activity of another project unreferenceable. The migration adds
// CHECK `entregables_cantidad_meta_check` (cantidad_meta > 0) and the partial
// unique index `entregables_codigo_activo_uq` over `(proyecto_id, lower(codigo))
// WHERE deleted_at IS NULL`. `tipo_medio_exigido` is free text (decision 5).
model Entregable {
  id                 String    @id @default(uuid())
  proyecto_id        String
  actividad_id       String
  codigo             String
  descripcion        String
  cantidad_meta      Decimal   @db.Decimal(15, 2)
  unidad             String
  tipo_medio_exigido String
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?

  proyecto  Proyecto  @relation(fields: [proyecto_id], references: [id])
  actividad Actividad @relation(fields: [actividad_id, proyecto_id], references: [id, proyecto_id], onDelete: NoAction, onUpdate: NoAction)
  avances   AvanceEntregable[]

  @@unique([id, proyecto_id])
  @@index([proyecto_id])
  @@index([actividad_id])
  @@map("entregables")
}

// v2 projects module (S4, SDD §4.8, REQ-EXE-01..07) — one progress record of a
// deliverable. Never deleted: a void sets `anulado_at` + `motivo_anulacion`
// (CHECK `avances_entregable_anulacion_check` keeps them together) and the row is
// excluded from every calculation. `cantidad > 0` is
// `avances_entregable_cantidad_check`; the composite relation
// `[entregable_id, proyecto_id]` keeps the deliverable in the same project.
// `registrado_por_id` / `anulado_por_id` are audit pointers without an FK.
model AvanceEntregable {
  id                   String    @id @default(uuid())
  proyecto_id          String
  entregable_id        String
  fecha                DateTime  @db.Date
  cantidad             Decimal   @db.Decimal(15, 2)
  observacion          String?
  justificacion_exceso String?
  registrado_por_id    String
  created_at           DateTime  @default(now())
  anulado_at           DateTime?
  anulado_por_id       String?
  motivo_anulacion     String?

  proyecto   Proyecto   @relation(fields: [proyecto_id], references: [id])
  entregable Entregable @relation(fields: [entregable_id, proyecto_id], references: [id, proyecto_id], onDelete: NoAction, onUpdate: NoAction)
  soportes   SoporteProyecto[]

  @@unique([id, proyecto_id])
  @@index([entregable_id, fecha])
  @@index([proyecto_id])
  @@map("avances_entregable")
}

// v2 projects module (AJ-01, S7) — one activity-level progress report (distinct from
// `AvanceEntregable`, which stays deliverable-level and untouched). Never hard-deleted: a
// void sets `anulado_at` + `motivo_anulacion` (same void-only pattern as `AvanceEntregable`).
// `observacion` is required here (unlike `AvanceEntregable.observacion`, which stays optional) —
// AJ-01 mandates an explanation on every report. `porcentaje > 0 AND porcentaje <= 100` is
// enforced by `reportes_actividad_porcentaje_check` (Postgres CHECK; Prisma cannot express a
// range, so this comment documents it the way `gastos_total_cuadra_ck` is documented on `Gasto`).
// The composite relation `[actividad_id, proyecto_id]` keeps the activity in the same project,
// mirroring `AvanceEntregable`'s relation to `Entregable`.
model ReporteActividad {
  id                 String    @id @default(uuid())
  proyecto_id        String
  actividad_id       String
  fecha              DateTime  @db.Date
  porcentaje         Decimal   @db.Decimal(5, 2)
  observacion        String
  registrado_por_id  String
  created_at         DateTime  @default(now())
  anulado_at         DateTime?
  anulado_por_id     String?
  motivo_anulacion   String?

  proyecto  Proyecto  @relation(fields: [proyecto_id], references: [id])
  actividad Actividad @relation(fields: [actividad_id, proyecto_id], references: [id, proyecto_id], onDelete: NoAction, onUpdate: NoAction)
  soportes  SoporteProyecto[]

  @@unique([id, proyecto_id])
  @@index([actividad_id, fecha])
  @@index([proyecto_id])
  @@map("reportes_actividad")
}

// v2 projects module (S4 U3, SDD §4.8, REQ-EXE-03) — a medio de verificación of
// an execution record: an uploaded file (`storage_path`, signed upload, never
// deleted from storage) or an external https link (`url_externa`). CHECKs
// `soportes_proyecto_padre_check` (at most one of avance_id / medicion_id / gasto_id /
// reporte_actividad_id — zero means the soporte is a project-origin document, migration 26),
// `soportes_proyecto_fuente_check` (exactly one of storage_path / url_externa) and
// `soportes_proyecto_tamano_check`; `storage_path` is unique so one stored object
// backs one medio. `avance_id` is a same-project composite FK; `medicion_id` is a
// same-project composite FK to the measurements table (S4 U4). Soft delete only (`deleted_at`).
// S6 adds `gasto_id` (same-project composite FK to `gastos`). AJ-01 (T1) adds
// `reporte_actividad_id` (same-project composite FK to the new `reportes_actividad` table) as a
// fourth possible parent; the CHECK keeps the same name and now reads
// `num_nonnulls(avance_id, medicion_id, gasto_id, reporte_actividad_id) <= 1`. Every consultation
// of an expense support is logged in `acceso_soportes`.
model SoporteProyecto {
  id                  String    @id @default(uuid())
  proyecto_id         String
  avance_id           String?
  medicion_id         String?
  gasto_id            String?
  reporte_actividad_id String?
  nombre              String
  storage_path        String?   @unique
  url_externa         String?
  tipo_mime           String?
  tamano_bytes        Int?
  subido_por_id       String
  created_at          DateTime  @default(now())
  deleted_at          DateTime?

  proyecto          Proyecto           @relation(fields: [proyecto_id], references: [id])
  avance            AvanceEntregable?  @relation(fields: [avance_id, proyecto_id], references: [id, proyecto_id], onDelete: NoAction, onUpdate: NoAction)
  medicion          MedicionIndicador? @relation(fields: [medicion_id, proyecto_id], references: [id, proyecto_id], onDelete: NoAction, onUpdate: NoAction)
  gasto             Gasto?             @relation(fields: [gasto_id, proyecto_id], references: [id, proyecto_id], onDelete: NoAction, onUpdate: NoAction)
  reporte_actividad ReporteActividad?  @relation(fields: [reporte_actividad_id, proyecto_id], references: [id, proyecto_id], onDelete: NoAction, onUpdate: NoAction)
  accesos           AccesoSoporte[]

  @@index([avance_id])
  @@index([medicion_id])
  @@index([gasto_id])
  @@index([reporte_actividad_id])
  @@index([proyecto_id])
  @@map("soportes_proyecto")
}

// v2 projects module (S3, SDD §4.8, REQ-STR-06) — a result indicator attached
// to one objective. The code (`IND-01`) is unique per project among live rows
// (`indicadores_codigo_activo_uq`); CHECKs `indicadores_meta_check` (meta > 0)
// and `indicadores_linea_base_check` (linea_base IS NULL OR linea_base >= 0);
// the composite relation `[objetivo_id, proyecto_id]` keeps the objective in the
// same project.
model Indicador {
  id          String    @id @default(uuid())
  proyecto_id String
  objetivo_id String
  codigo      String
  nombre      String
  meta        Decimal   @db.Decimal(15, 2)
  unidad      String
  linea_base  Decimal?  @db.Decimal(15, 2)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  proyecto Proyecto @relation(fields: [proyecto_id], references: [id])
  objetivo Objetivo @relation(fields: [objetivo_id, proyecto_id], references: [id, proyecto_id], onDelete: NoAction, onUpdate: NoAction)
  mediciones MedicionIndicador[]

  @@unique([id, proyecto_id])
  @@index([proyecto_id])
  @@index([objetivo_id])
  @@map("indicadores")
}

// v2 projects module (S4 U4, SDD §4.8, REQ-EXE-04/07) — one measurement of a
// result indicator. Voided, never deleted (CHECK `mediciones_indicador_anulacion_check`
// keeps `anulado_at` + `motivo_anulacion` together); `valor >= 0` is
// `mediciones_indicador_valor_check`; the composite relation
// `[indicador_id, proyecto_id]` keeps the indicator in the same project. Audit
// pointers carry no FK.
model MedicionIndicador {
  id                String    @id @default(uuid())
  proyecto_id       String
  indicador_id      String
  fecha             DateTime  @db.Date
  valor             Decimal   @db.Decimal(15, 2)
  observacion       String?
  registrado_por_id String
  created_at        DateTime  @default(now())
  anulado_at        DateTime?
  anulado_por_id    String?
  motivo_anulacion  String?

  proyecto  Proyecto   @relation(fields: [proyecto_id], references: [id])
  indicador Indicador  @relation(fields: [indicador_id, proyecto_id], references: [id, proyecto_id], onDelete: NoAction, onUpdate: NoAction)
  soportes  SoporteProyecto[]

  @@unique([id, proyecto_id])
  @@index([indicador_id, fecha])
  @@index([proyecto_id])
  @@map("mediciones_indicador")
}

// v2 projects module (S4 U4, SDD §4.8, REQ-EXE-05/07) — a beneficiary count
// registered on a date, optionally tied to one activity of the same project
// (composite relation; a null `actividad_id` skips the key). `cantidad > 0` is
// `registros_beneficiarios_cantidad_check`. Voided, never deleted.
model RegistroBeneficiario {
  id                String    @id @default(uuid())
  proyecto_id       String
  actividad_id      String?
  fecha             DateTime  @db.Date
  cantidad          Int
  observacion       String?
  registrado_por_id String
  created_at        DateTime  @default(now())
  anulado_at        DateTime?
  anulado_por_id    String?
  motivo_anulacion  String?

  proyecto  Proyecto   @relation(fields: [proyecto_id], references: [id])
  actividad Actividad? @relation(fields: [actividad_id, proyecto_id], references: [id, proyecto_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id, proyecto_id])
  @@index([proyecto_id, fecha])
  @@index([actividad_id])
  @@map("registros_beneficiarios")
}

// v2 projects module (S5, SDD §3.7, REQ-BUD-01..05) — assigned amount (A) of one
// rubro in one project. Adoptive: production may still hold the v1 table, so the
// migration is idempotent. Lines are never deleted ($0 is the "off" state, and
// rubros are never deleted either), hence no `deleted_at`. CHECK
// `lineas_monto_no_negativo_ck` keeps the amount >= 0; `@@unique([id, proyecto_id])`
// is the FK target for programming now and expenses in S6.
model LineaPresupuestal {
  id                   String   @id @default(uuid())
  proyecto_id          String
  rubro_id             String
  monto_proyectado_cop Decimal  @db.Decimal(15, 2)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  proyecto     Proyecto               @relation(fields: [proyecto_id], references: [id])
  rubro        Rubro                  @relation(fields: [rubro_id], references: [id])
  programacion ProgramacionPeriodo[]
  gastos       Gasto[]

  @@unique([proyecto_id, rubro_id])
  @@unique([id, proyecto_id])
  @@index([proyecto_id])
  @@map("lineas_presupuestales")
}

// v2 projects module (S5, SDD §3.7, REQ-BUD-03) — programmed amount (P) of one
// budget line in one month (`periodo` "AAAA-MM", CHECK `programacion_periodo_ck`).
// The composite relation keeps the line in the same project. Written by diff in
// BORRADOR: a cell that becomes 0 is deleted; history lives in `auditoria_cambios`.
model ProgramacionPeriodo {
  id          String   @id @default(uuid())
  proyecto_id String
  linea_id    String
  periodo     String   @db.Char(7)
  valor       Decimal  @db.Decimal(15, 2)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  proyecto Proyecto          @relation(fields: [proyecto_id], references: [id])
  linea    LineaPresupuestal @relation(fields: [linea_id, proyecto_id], references: [id, proyecto_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([linea_id, periodo])
  @@index([proyecto_id, periodo])
  @@map("programacion_periodo")
}

enum EstadoGasto {
  REGISTRADO
  VALIDADO
  RECHAZADO
  ANULADO
}

enum TipoSoporteGasto {
  FACTURA_PROVEEDOR
  CUENTA_COBRO_PERSONA_NATURAL
  OTRO
}

enum TipoIdentificacion {
  NIT
  CC
  CE
}

// v2 projects module (S6, SDD §3.9, RF-20..22) — one expense against a budget line. The
// composite relation `[linea_id, proyecto_id]` keeps the line in the same project. CHECKs
// (the invariant test asserts these names): `gastos_monto_positivo_ck`, `gastos_periodo_ck`,
// `gastos_validador_ck` (validator <> registrant), `gastos_rechazo_ck`, `gastos_rechazador_ck`,
// `gastos_validado_ck` (VALIDADO needs validator, date and the third-party id: N-15) and
// `gastos_anulado_ck` (ANULADO <=> the three anulado_* columns). `datos_incompletos` is derived
// (tercero_tipo_id or tercero_numero_id null), never stored. `*_norm` columns are written by the
// app from `lib/proyectos/gastos.ts` and used only for the duplicate lookup (RF-21). Actor ids
// carry no FK (same choice as S4). The third-party number never goes to the audit ledger.
model Gasto {
  id                    String             @id @default(uuid())
  proyecto_id           String
  linea_id              String
  fecha_documento       DateTime           @db.Date
  periodo               String             @db.Char(7)
  tipo_soporte          TipoSoporteGasto
  tercero_nombre        String
  tercero_tipo_id       TipoIdentificacion?
  tercero_numero_id     String?
  tercero_id_norm       String?
  numero_documento      String
  numero_documento_norm String
  descripcion           String
  subtotal_cop          Decimal            @db.Decimal(15, 2)
  iva_cop               Decimal            @default(0) @db.Decimal(15, 2)
  /// Total = subtotal_cop + iva_cop (enforced by `gastos_total_cuadra_ck`); the executed amount.
  monto_cop             Decimal            @db.Decimal(15, 2)
  estado                EstadoGasto        @default(REGISTRADO)
  alerta_sobregasto     Boolean            @default(false)
  registrado_por_id     String
  created_at            DateTime           @default(now())
  updated_at            DateTime           @updatedAt
  validado_por_id       String?
  validado_at           DateTime?
  rechazado_por_id      String?
  rechazado_at          DateTime?
  motivo_rechazo        String?
  anulado_por_id        String?
  anulado_at            DateTime?
  motivo_anulacion      String?

  proyecto Proyecto          @relation(fields: [proyecto_id], references: [id])
  linea    LineaPresupuestal @relation(fields: [linea_id, proyecto_id], references: [id, proyecto_id], onDelete: NoAction, onUpdate: NoAction)
  soportes SoporteProyecto[]
  notificaciones Notificacion[]

  @@unique([id, proyecto_id])
  @@index([proyecto_id, estado, periodo])
  @@index([linea_id, estado])
  @@index([tercero_id_norm, numero_documento_norm])
  @@index([estado, created_at])
  @@map("gastos")
}

// v2 projects module (S6, RNF-04) — append-only log of every issued download of an expense
// support. Triggers reject UPDATE/DELETE/TRUNCATE (`acceso_soportes_inmutable()`). The soporte
// FK is RESTRICT; the actor id carries no FK.
model AccesoSoporte {
  id          String   @id @default(uuid())
  soporte_id  String
  proyecto_id String
  usuario_id  String
  created_at  DateTime @default(now())

  soporte SoporteProyecto @relation(fields: [soporte_id], references: [id], onDelete: Restrict)

  @@index([proyecto_id, created_at])
  @@index([soporte_id])
  @@map("acceso_soportes")
}

// v2 projects module (S8, RF-05/RF-26..29) — baseline and modification versions.
enum TipoVersion {
  LINEA_BASE
  MODIFICACION
}

enum TipoModificacion {
  TRASLADO
  ADICION
  REDUCCION
  REPROGRAMACION
  CRONOGRAMA
  ENTREGABLES
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

// Immutable JSON snapshot of the approved structure + budget. Triggers reject UPDATE/DELETE/
// TRUNCATE (`versiones_proyecto_inmutable()`); CHECKs tie `numero = 0` to LINEA_BASE and
// MODIFICACION to a `solicitud_id`. The approver id carries no FK (like other audit pointers).
model VersionProyecto {
  id              String      @id @default(uuid())
  proyecto_id     String
  numero          Int
  tipo            TipoVersion
  solicitud_id    String?     @unique
  aprobado_por_id String
  aprobado_at     DateTime    @default(now())
  snapshot        Json

  proyecto  Proyecto               @relation(fields: [proyecto_id], references: [id], onDelete: Restrict)
  solicitud SolicitudModificacion? @relation(fields: [solicitud_id], references: [id], onDelete: Restrict)

  @@unique([proyecto_id, numero])
  @@index([proyecto_id])
  @@map("versiones_proyecto")
}

model SolicitudModificacion {
  id                  String           @id @default(uuid())
  proyecto_id         String
  tipo                TipoModificacion
  motivo              String
  detalle             Json
  version_base_numero Int
  estado              EstadoSolicitud  @default(PENDIENTE)
  solicitado_por_id   String
  solicitado_at       DateTime         @default(now())
  decidido_por_id     String?
  decidido_at         DateTime?
  comentario_decision String?

  proyecto Proyecto         @relation(fields: [proyecto_id], references: [id], onDelete: Restrict)
  version  VersionProyecto?

  @@index([proyecto_id, estado])
  @@map("solicitudes_modificacion")
}
