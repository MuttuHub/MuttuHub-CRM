// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum RolUsuario {
  ADMINISTRADOR
  GERENCIA
  COORDINADOR
  COLABORADOR
}

enum EstadoCliente {
  PROSPECTO
  EN_ACERCAMIENTO
  CLIENTE_ACTIVO
  EN_PAUSA
  STANDBY
  INACTIVO
  CERRADO
}

enum TipoCliente {
  GOBIERNO_LOCAL
  GOBIERNO_NACIONAL
  COOPERANTE_MULTILATERAL
  EMPRESA_PRIVADA
  FUNDACION
  ALIADO_ACADEMICO
  OTRO
}

enum PrioridadCliente {
  ALTA
  MEDIA
  BAJA
}

enum RolContacto {
  DECISOR
  TECNICO
  INFLUENCIADOR
  OTRO
}

enum EstadoOportunidad {
  DISENANDO_PROPUESTA
  PRESENTADA
  EN_REVISION
  EN_NEGOCIACION
  GANADA
  PERDIDA
  STANDBY
}

enum FaseOportunidad {
  PROSPECCION
  EJECUCION
}

enum EstadoTarea {
  POR_HACER
  EN_CURSO
  EN_REVISION
  COMPLETADA
  BLOQUEADA
  EN_ESPERA
  CANCELADA // estado oculto en tablero, visible en reportes
}

enum OrigenTarea {
  CRM
  KANBAN
  AMBOS
}

enum PrioridadTarea {
  ALTA
  MEDIA
  BAJA
}

enum TipoNotificacion {
  COMPROMISO_VENCIDO
  TAREA_VENCIDA
  POR_VENCER
}

// ─────────────────────────────────────────
// MODELOS
// ─────────────────────────────────────────

model Usuario {
  id                     String     @id @default(uuid())
  email                  String     @unique
  nombre                 String
  rol                    RolUsuario @default(COLABORADOR)
  activo                 Boolean    @default(true)
  // Eje comercial ortogonal a `rol` (oportunidades-comerciales D3). Sembrado
  // por la migración para los COLABORADORES responsables de clientes con al
  // menos una oportunidad viva, así el deploy no deja a nadie sin acceso.
  gestiona_oportunidades Boolean    @default(false)
  created_at             DateTime   @default(now())
  updated_at             DateTime   @updatedAt

  clientes_asignados Cliente[]
  tareas_asignadas   Tarea[]
  bitacora_entradas  BitacoraEntrada[]
  documentos_subidos Documento[]
  notificaciones     Notificacion[]
  accesos            Acceso[] // PRD §3.3
  auditorias         Auditoria[]

  @@map("usuarios")
}

model Cliente {
  id                        String            @id @default(uuid())
  nombre                    String
  empresa                   String?
  tipo_cliente              TipoCliente
  tamano_org                String?
  ubicacion                 String?
  canal_contacto_inicial    String?
  fecha_primer_contacto     DateTime?
  prioridad                 PrioridadCliente?
  prioridades_identificadas String?
  riesgos_barreras          String?
  resumen_relacion          String?
  estado                    EstadoCliente     @default(PROSPECTO)
  responsable_id            String
  created_at                DateTime          @default(now())
  updated_at                DateTime          @updatedAt
  deleted_at                DateTime?

  responsable   Usuario            @relation(fields: [responsable_id], references: [id])
  contactos     Contacto[]
  oportunidades Oportunidad[]
  tareas        Tarea[]
  bitacora      BitacoraEntrada[]
  documentos    DocumentoCliente[]

  @@map("clientes")
}

model Contacto {
  id           String       @id @default(uuid())
  cliente_id   String
  nombre       String
  cargo        String?
  correo       String?
  telefono     String?
  rol_decision RolContacto?
  notas        String?
  created_at   DateTime     @default(now())
  deleted_at   DateTime?

  cliente Cliente @relation(fields: [cliente_id], references: [id])

  @@map("contactos")
}

model Oportunidad {
  id                     String            @id @default(uuid())
  cliente_id             String
  nombre                 String
  problema_detectado     String?
  solucion_propuesta     String?
  servicios_interes      String?
  valor_estimado_cop     Decimal?          @db.Decimal(15, 2)
  estado                 EstadoOportunidad @default(DISENANDO_PROPUESTA)
  fecha_ultima_gestion   DateTime?
  // Ciclo comercial trazable (oportunidades-comerciales D2). `fase` distingue
  // prospección de ejecución tras la conversión explícita y auditada de una
  // oportunidad GANADA; `fecha_adjudicacion` se fija una sola vez por esa
  // acción. `fecha_envio_propuesta` (RF-C03) es fija: se setea la primera vez
  // que se registra el envío y nunca se sobreescribe en PATCH posteriores —
  // a diferencia de `fecha_ultima_gestion`, que sigue mutando en cada PATCH.
  fase                   FaseOportunidad   @default(PROSPECCION)
  fecha_adjudicacion     DateTime?
  fecha_envio_propuesta  DateTime?
  /// @deprecated oportunidades-comerciales D8 — superseded by `fase` +
  /// `Tarea.oportunidad_id`. Read-only in the UI; kept additive, not dropped.
  proyectos_relacionados String?
  created_at             DateTime          @default(now())
  updated_at             DateTime          @updatedAt
  deleted_at             DateTime?

  cliente  Cliente           @relation(fields: [cliente_id], references: [id])
  tareas   Tarea[]
  bitacora BitacoraEntrada[]

  // Objetivo de la FK compuesta de Tarea/BitacoraEntrada (D1): garantiza a
  // nivel de base de datos que una tarea u entrada de bitácora vinculada a
  // esta oportunidad solo pueda apuntar al mismo cliente_id.
  @@unique([id, cliente_id])
  @@map("oportunidades")
}

// Tabla unificada CRM + Kanban
model Tarea {
  id             String          @id @default(uuid())
  titulo         String
  descripcion    String?
  responsable_id String
  cliente_id     String?
  // Vínculo opcional a una oportunidad comercial (oportunidades-comerciales
  // D1/RF-C02). Sin backfill: toda tarea preexistente queda con este campo
  // en NULL — el re-vinculado es manual desde la vista de la oportunidad.
  oportunidad_id String?
  estado         EstadoTarea     @default(POR_HACER)
  origen         OrigenTarea     @default(KANBAN)
  prioridad      PrioridadTarea?
  fecha_entrega  DateTime?
  etiquetas      String[]        @default([])
  motivo_bloqueo String? // solo cuando estado = BLOQUEADA
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  deleted_at     DateTime?
  // Plan Fase 3 (3B): la marca REAL de cierre, agregada porque updated_at
  // (el proxy histórico) se movía al renombrar/comentar una tarea ya
  // completada — el reporte pasaba retroactivamente "a tiempo" a "tarde".
  // Nullable y con backfill (SET = updated_at WHERE estado='COMPLETADA');
  // null = nunca completada (o reabierta tras completarse). Se escribe solo
  // desde el helper central completedAtFor (status + PATCH).
  completed_at   DateTime?

  responsable    Usuario           @relation(fields: [responsable_id], references: [id])
  cliente        Cliente?          @relation(fields: [cliente_id], references: [id])
  // Relación compuesta deliberada (D1): comparte el escalar `cliente_id` con
  // la relación `cliente` de arriba. Esa superposición ES el invariante —
  // hace imposible, a nivel de base de datos, que una tarea apunte a una
  // oportunidad de un cliente distinto al suyo. `onDelete/onUpdate: NoAction`
  // es obligatorio: dos relaciones que comparten un escalar generan rutas de
  // cascada en conflicto, que Prisma rechaza. El borrado lógico
  // (`deleted_at`) es el modelo de borrado del proyecto de todos modos, así
  // que `NoAction` no cuesta nada. El `CHECK` que cierra el hueco de
  // MATCH SIMPLE (cliente_id NULL) vive en la migración — Prisma no modela
  // constraints CHECK.
  oportunidad    Oportunidad?      @relation(fields: [oportunidad_id, cliente_id], references: [id, cliente_id], onDelete: NoAction, onUpdate: NoAction)
  comentarios    ComentarioTarea[]
  subtareas      Subtarea[]
  adjuntos       AdjuntoTarea[]
  notificaciones Notificacion[]

  @@index([oportunidad_id])
  @@map("tareas")
}

// Inmutable por diseño — sin updated_at
model BitacoraEntrada {
  id             String   @id @default(uuid())
  cliente_id     String
  autor_id       String
  texto          String
  // Comunicación específica de una oportunidad (oportunidades-comerciales).
  // Nullable: las entradas atadas solo al cliente no se ven afectadas.
  oportunidad_id String?
  created_at     DateTime @default(now())

  cliente     Cliente      @relation(fields: [cliente_id], references: [id])
  autor       Usuario      @relation(fields: [autor_id], references: [id])
  // Misma relación compuesta que Tarea (D1) — cliente_id compartido es el
  // invariante. `BitacoraEntrada.cliente_id` ya es NOT NULL, así que el hueco
  // de MATCH SIMPLE no existe aquí; el CHECK de la migración es solo para
  // `tareas`.
  oportunidad Oportunidad? @relation(fields: [oportunidad_id, cliente_id], references: [id, cliente_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("bitacora_entradas")
}

// La carpeta es el eje de ORGANIZACIÓN, nunca el de permisos: `categoria` es lo
// que leen canReadCategory y los gates de subida/zip. Mover un documento entre
// carpetas jamás puede cambiar quién lo lee — esa escalada de privilegios
// disparada por un gesto de organización es exactamente lo que este modelo evita.
model Carpeta {
  id            String    @id @default(uuid())
  nombre        String
  parent_id     String? // null = raíz; no hay fila "root"
  creado_por_id String
  created_at    DateTime  @default(now())
  deleted_at    DateTime?

  parent     Carpeta?    @relation("CarpetaArbol", fields: [parent_id], references: [id])
  hijas      Carpeta[]   @relation("CarpetaArbol")
  documentos Documento[]

  @@index([parent_id])
  @@map("carpetas")
}

model Documento {
  id         String    @id @default(uuid())
  titulo     String
  categoria  String // String libre — configurable desde admin sin tocar código
  etiquetas  String[]  @default([])
  autor_id   String
  created_at DateTime  @default(now())
  deleted_at DateTime?
  carpeta_id String?

  autor          Usuario            @relation(fields: [autor_id], references: [id])
  carpeta        Carpeta?           @relation(fields: [carpeta_id], references: [id])
  versiones      DocumentoVersion[]
  clientes       DocumentoCliente[]
  adjuntos_tarea AdjuntoTarea[] // QA audit finding #12: espejo del adjunto de origen, si lo hay

  // El listado por defecto filtra deleted_at y ordena por created_at desc.
  @@index([deleted_at, created_at])
  @@index([carpeta_id])
  @@map("documentos")
}

model DocumentoVersion {
  id              String   @id @default(uuid())
  documento_id    String
  numero_version  Int
  storage_path    String // path en Supabase Storage
  tamano_bytes    Int?
  tipo_archivo    String?
  subido_por_id   String
  created_at      DateTime @default(now())
  contenido_texto String? // texto extraído (null = sin texto / sin procesar)
  texto_estado    String? // "ok" | "sin_texto" | "error" | null (= nunca procesado)

  documento Documento @relation(fields: [documento_id], references: [id])

  @@unique([documento_id, numero_version])
  @@map("documento_versiones")
}

model DocumentoCliente {
  documento_id String
  cliente_id   String

  documento Documento @relation(fields: [documento_id], references: [id])
  cliente   Cliente   @relation(fields: [cliente_id], references: [id])

  @@id([documento_id, cliente_id])
  // La PK compuesta (documento_id, cliente_id) no sirve para el filtro ?cliente=
  @@index([cliente_id])
  @@map("documentos_clientes")
}

model ComentarioTarea {
  id         String   @id @default(uuid())
  tarea_id   String
  autor_id   String
  texto      String
  created_at DateTime @default(now())

  tarea Tarea @relation(fields: [tarea_id], references: [id])

  @@map("comentarios_tareas")
}

model Subtarea {
  id         String  @id @default(uuid())
  tarea_id   String
  titulo     String
  completada Boolean @default(false)

  tarea Tarea @relation(fields: [tarea_id], references: [id])

  @@map("subtareas")
}

model AdjuntoTarea {
  id           String   @id @default(uuid())
  tarea_id     String
  storage_path String
  nombre       String
  tamano_bytes Int? // tamaño del archivo subido (supabase no lo expone en el listado)
  created_at   DateTime @default(now())
  // QA audit finding #12: espejo en el Repositorio de Documentos (mismo
  // storage_path, sin volver a subir el archivo). Nullable: solo lo tienen
  // los adjuntos subidos después de este cambio (sin backfill de los
  // existentes) o si el espejo falla — el adjunto en sí nunca depende de
  // esto. Sin onDelete: borrar la tarea nunca debe arrastrar el documento,
  // que sigue viviendo como registro de negocio propio en el Repositorio.
  documento_id String?

  tarea     Tarea      @relation(fields: [tarea_id], references: [id])
  documento Documento? @relation(fields: [documento_id], references: [id])

  @@map("adjuntos_tareas")
}

model Notificacion {
  id         String           @id @default(uuid())
  usuario_id String
  tipo       TipoNotificacion
  tarea_id   String?
  leida      Boolean          @default(false)
  created_at DateTime         @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id])
  tarea   Tarea?  @relation(fields: [tarea_id], references: [id])

  @@map("notificaciones")
}

// PRD §3.3 — bitácora de accesos (quién entró, cuándo)
model Acceso {
  id         String   @id @default(uuid())
  usuario_id String
  created_at DateTime @default(now())
  ip         String?
  user_agent String?

  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@map("accesos")
}

// QA audit finding #9: `Acceso` solo cubre inicios de sesión — no había
// ningún registro de creación/edición/eliminación de los registros de
// negocio (Cliente, Tarea, Documento). `cambios` guarda un snapshot liviano
// de los campos enviados en la operación (no un diff antes/después completo:
// eso hubiera requerido leer el estado previo en cada PATCH solo para
// auditoría). `entidad_id` no lleva FK a propósito — sobrevive al soft
// delete y a que el recurso referenciado ya no exista.
model Auditoria {
  id         String   @id @default(uuid())
  entidad    String // "cliente" | "tarea" | "documento"
  entidad_id String
  accion     String // "crear" | "editar" | "eliminar"
  usuario_id String
  cambios    Json?
  created_at DateTime @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@index([entidad, entidad_id])
  // Code review finding: GET /api/v1/auditoria siempre ordena por
  // created_at desc y opcionalmente filtra por entidad — ninguno de los
  // índices anteriores cubría ese patrón. (created_at, id) también respalda
  // el cursor compuesto de la paginación (ver el mismo hallazgo sobre el
  // cursor no único).
  @@index([created_at, id])
  @@index([entidad, created_at, id])
  @@map("auditoria")
}

// PRD §4.4.1 + §8.4 — log del cron de notificaciones (retención 30 días)
model CronLog {
  id         String   @id @default(uuid())
  job_name   String
  estado     String
  detalle    String?
  created_at DateTime @default(now())

  @@map("cron_logs")
}

// PRD §3.1 — public access requests: who asked to join and how it was approved
// (email form or Google OAuth). `revisado_por` / `auth_id` are log-only
// columns without FK (same pattern as Setting.updated_by).
model SolicitudAcceso {
  id           String    @id @default(uuid())
  nombre       String
  email        String
  cargo        String?
  origen       String    @default("form") // "form" | "google" — how the request arrived
  auth_id      String? // when origen=google: id of the auth user already created by Supabase
  estado       String    @default("PENDIENTE") // PENDIENTE | APROBADA | RECHAZADA
  revisado_por String?
  revisado_at  DateTime?
  created_at   DateTime  @default(now())

  @@map("solicitudes_acceso")
}

// PRD §3.3 — setting key/value para los catálogos configurables desde el admin
// (task_tags, doc_categories y futuros). `value` guarda el JSON del catálogo;
// `updated_by` es el id del usuario que lo editó (sin FK, log-only).
model Setting {
  id         String   @id @default(uuid())
  key        String   @unique
  value      Json
  updated_by String?
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  @@map("settings")
}
