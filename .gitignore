# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright — run artifacts (videos, traces, HTML report); the spec + config
# under e2e/ and playwright.config.ts ARE meant to be committed
/test-results/
/playwright-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel/*
!.vercel/project.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Windows Zone.Identifier sidecars
*:Zone.Identifier

# local agent caches
.atl/
.agents/
.claude/
skills-lock.json

# TestSprite suite — tests ARE committed (the GitHub Action needs them);
# only tmp internals with real secrets stay ignored
testsprite_tests/tmp/*
!testsprite_tests/tmp/test_results.json
testsprite_tests/tmp/config.json
testsprite_tests/tmp/mcp.log
testsprite_tests/tmp/code_summary.yaml
testsprite_tests/tmp/raw_report.md
testsprite_tests/tmp/prd_files/
